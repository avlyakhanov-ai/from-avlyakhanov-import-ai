#!/usr/bin/env python3
"""meeting-notes: конспект встречи или разбор собеседования из расшифровки TypeWhisper.

Использование:
  meeting-notes                 конспект по расшифровке последней записи Recorder
  meeting-notes файл.txt        конспект по указанному файлу
  meeting-notes --interview     разбор собеседования вместо конспекта
  meeting-notes --clipboard     взять расшифровку из буфера обмена
  meeting-notes --dry-run       только показать, какой текст будет взят

Результат сохраняется в ~/Documents/Конспекты встреч (или в MEETING_NOTES_DIR),
копируется в буфер обмена (прежнее содержимое буфера заменяется), путь печатается в конце.
ИИ: Claude Code (`claude -p`), если его нет, Codex (`codex exec`).
Папку записей Recorder задает RECORDINGS ниже или переменная MEETING_NOTES_RECORDINGS.
Источник: https://github.com/avlyakhanov-ai/from-avlyakhanov-import-ai/tree/main/typewhisper
"""
import argparse
import datetime
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HOME = Path.home()
# Если Recorder сохраняет записи в другую папку, поменяй путь здесь.
OUT_DIR = Path(os.environ.get("MEETING_NOTES_DIR", HOME / "Documents" / "Конспекты встреч"))
PROMPTS = Path(os.environ.get("MEETING_NOTES_PROMPTS", HOME / ".local" / "share" / "meeting-notes"))
TIMEOUT = 600
AUDIO = {".wav", ".m4a", ".mp3", ".aiff", ".caf"}


def _recordings_dir():
    """Папка Recorder: из переменной или та из двух обычных, где запись свежее."""
    if os.environ.get("MEETING_NOTES_RECORDINGS"):
        return Path(os.environ["MEETING_NOTES_RECORDINGS"])
    cands = [HOME / "TypeWhisper Recordings", HOME / "Documents" / "TypeWhisper Recordings"]

    def newest(d):
        try:
            return max((f.stat().st_mtime for f in d.iterdir() if f.suffix.lower() in AUDIO), default=0)
        except OSError:
            return 0
    return max(cands, key=newest)


RECORDINGS = _recordings_dir()


def fail(msg):
    print(f"meeting-notes: {msg}", file=sys.stderr)
    sys.exit(1)


def stamp_of(path):
    return datetime.datetime.fromtimestamp(path.stat().st_mtime).strftime("%Y-%m-%d %H:%M")


def latest_recorder_transcript():
    """Расшифровка последней записи. Ошибка, если последняя запись еще не расшифрована."""
    if not RECORDINGS.is_dir():
        fail(f"нет папки записей Recorder: {RECORDINGS}\n"
             "Укажи файл расшифровки аргументом, используй --clipboard "
             "или поправь RECORDINGS в начале скрипта.")
    files = [p for p in RECORDINGS.iterdir() if p.is_file()]
    texts = [p for p in files if p.suffix == ".txt" and p.stat().st_size > 0]
    # Запись, которую Recorder не смог расшифровать (например, случайные пару секунд), пропускаем.
    audio = [p for p in files if p.suffix.lower() in AUDIO
             and not Path(f"{p}.transcription-failure.json").exists()]
    if audio:
        last_audio = max(audio, key=lambda p: p.stat().st_mtime)
        twin = last_audio.with_suffix(".txt")
        if not (twin.is_file() and twin.stat().st_size > 0):
            fail(f"расшифровка последней записи еще не готова: {last_audio.name} ({stamp_of(last_audio)}).\n"
                 "Подожди, пока Recorder допишет текст, или укажи файл расшифровки аргументом.")
        return twin
    if not texts:
        fail(f"в {RECORDINGS} нет расшифровок. Укажи файл аргументом или используй --clipboard.")
    return max(texts, key=lambda p: p.stat().st_mtime)


# pbcopy и pbpaste без UTF-8 локали портят кириллицу (у агентов LANG часто пустой).
UTF8_ENV = {**os.environ, "LANG": "en_US.UTF-8", "LC_ALL": "en_US.UTF-8"}


def clipboard():
    try:
        out = subprocess.run(["pbpaste"], capture_output=True, check=True, env=UTF8_ENV).stdout
        return out.decode("utf-8", errors="replace")
    except (OSError, subprocess.CalledProcessError):
        fail("не удалось прочитать буфер обмена")


def run(cmd, prompt=None):
    return subprocess.run(cmd, input=prompt, capture_output=True, text=True,
                          timeout=TIMEOUT, cwd=tempfile.gettempdir())


def ask_ai(prompt):
    claude = shutil.which("claude")
    if claude:
        # Чистый запуск: без инструментов, MCP, пользовательских настроек, хуков и CLAUDE.md,
        # из нейтральной папки, чтобы в конспект не попадал посторонний контекст.
        strict = [claude, "-p", "--tools", "", "--strict-mcp-config", "--no-session-persistence",
                  "--setting-sources", "", "--disable-slash-commands"]
        res = run(strict, prompt)
        if res.returncode != 0 or not res.stdout.strip():
            # Старая версия Claude Code без этих флагов или вход по ключу из настроек,
            # которые отключает --setting-sources "". Пробуем обычный запуск.
            print("Чистый запуск Claude не сработал, пробую обычный "
                  "(в ответ может попасть текст из твоих глобальных инструкций).", file=sys.stderr)
            res = run([claude, "-p"], prompt)
    elif shutil.which("codex"):
        # Только чтение: расшифровка не должна заставить агента что-то выполнить.
        res = run(["codex", "exec", "--skip-git-repo-check", "--sandbox", "read-only", prompt])
    else:
        fail("не найден ни Claude Code (claude), ни Codex (codex)")
    if res.returncode != 0 or not res.stdout.strip():
        fail(f"ИИ вернул ошибку (код {res.returncode}): {res.stderr.strip()[:500]}")
    return res.stdout.strip()


def main():
    ap = argparse.ArgumentParser(prog="meeting-notes", description="Конспект встречи из расшифровки TypeWhisper")
    ap.add_argument("file", nargs="?", help="файл с расшифровкой (.txt)")
    ap.add_argument("-i", "--interview", action="store_true", help="разбор собеседования вместо конспекта")
    ap.add_argument("-c", "--clipboard", action="store_true", help="взять расшифровку из буфера обмена")
    ap.add_argument("-n", "--dry-run", action="store_true", help="показать источник и выйти")
    args = ap.parse_args()

    if args.file:
        src = Path(args.file).expanduser()
        if not src.is_file():
            fail(f"файл не найден: {src}")
        text, label, name = src.read_text(encoding="utf-8", errors="replace"), f"{src} ({stamp_of(src)})", src.stem
    elif args.clipboard:
        text, label, name = clipboard(), "буфер обмена", "из буфера"
    else:
        src = latest_recorder_transcript()
        text, label, name = src.read_text(encoding="utf-8", errors="replace"), f"{src} ({stamp_of(src)})", src.stem

    text = text.strip()
    if not text:
        fail(f"пустая расшифровка: {label}")
    print(f"Источник: {label}, {len(text)} знаков")
    if args.dry_run:
        return

    kind = "interview" if args.interview else "meeting"
    prompt_file = PROMPTS / f"{kind}.md"
    if not prompt_file.is_file():
        fail(f"нет промпта: {prompt_file}")
    prompt = prompt_file.read_text(encoding="utf-8").strip() + "\n\nРасшифровка:\n\n" + text

    print("Отправляю в ИИ…")
    result = ask_ai(prompt)

    OUT_DIR.mkdir(parents=True, exist_ok=True)
    stamp = datetime.datetime.now().strftime("%Y-%m-%d %H-%M")
    word = "разбор" if args.interview else "конспект"
    out = OUT_DIR / f"{stamp} {word} ({name}).md"
    n = 2
    while out.exists():
        out = OUT_DIR / f"{stamp} {word} ({name}) {n}.md"
        n += 1
    out.write_text(result + "\n", encoding="utf-8")
    try:
        subprocess.run(["pbcopy"], input=result.encode("utf-8"), check=True, env=UTF8_ENV)
        copied = " и скопирован в буфер обмена"
    except (OSError, subprocess.CalledProcessError):
        copied = ""
    print(f"Готово{copied}: {out}")


if __name__ == "__main__":
    main()
